[Desktop Entry]
Type=Application
Name=macshell
Comment=macOS Tahoe-style desktop shell
# KWin offers the interfaces below only to the executable named here, so Exec must be the
# absolute path of the installed macshell binary (packaging fills it in).
Exec=@macshell@
NoDisplay=true
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management
