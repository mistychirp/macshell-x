[Desktop Entry]
Type=Application
Name=System Settings
Comment=Settings for the makshell desktop
# A launcher, not the makshell binary itself. KWin grants window management by looking for desktop
# entries whose Exec is a client's executable, and only reads the first one it finds: naming the
# binary here too can leave the shell without a window list.
Exec=@makshell@-settings
Icon=preferences-system
Categories=Settings;
StartupWMClass=makshell-settings
