// Liquid glass settings for the macshell niri fork (compositor/niri, branch `macshell`); stock
// niri rejects the `glass` block. Include it from your niri config:
//   include "~/Projects/macshell-x/contrib/niri-glass.kdl"
//
// The shell asks for glass itself through the macshell-glass-v1 protocol, so no layer rules
// are needed. (A `background-effect { glass true; }` rule on a macshell surface would render
// glass twice.) Frosted glass uses the strength of the blur settings in this same section.
//
// You can only have one top-level `blur` section. If your config already has one, move the
// `glass` block into it instead.

blur {
    glass {
        // Width of the curved rim, in logical pixels.
        bezel 20
        // How far the rim bends the background at its outer edge. Negative flips the direction.
        refraction 16
        // Strength of the specular highlight along the rim.
        highlight 0.35
        // Tint over the glass, e.g. "#ffffff10" for a faint white.
        tint "#ffffff00"
    }
}
